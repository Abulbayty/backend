# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dorisio

# Redis
REDIS_URL=redis://localhost:6379

# External services circuit breaker
# Failure rate (0-1) of calls within the rolling window that trips the circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
# Consecutive successes required in HALF_OPEN before the circuit closes again
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
# Per-call timeout: calls slower than this are treated as failures
CIRCUIT_BREAKER_TIMEOUT_MS=60000
# How long the circuit stays OPEN before allowing a HALF_OPEN trial call
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
# Minimum number of calls in the rolling window before the failure rate is evaluated
CIRCUIT_BREAKER_MIN_REQUESTS=5
# Length of the rolling window used to compute the failure rate
CIRCUIT_BREAKER_ROLLING_WINDOW_MS=60000
# Minimum call volume in the window before the circuit may trip (warm-up guard)
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
# Per-integration toggles
STELLAR_CIRCUIT_BREAKER_ENABLED=true
WEBHOOK_CIRCUIT_BREAKER_ENABLED=true

# Stellar/Soroban
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Per-call timeout applied to Stellar Horizon requests
STELLAR_HORIZON_TIMEOUT_MS=60000
STELLAR_SERVER_SECRET_KEY=your-server-keypair-secret-key
USDC_CONTRACT_ID=CBBD47AB2EB00E041B61C1B7AD184E687E24658D52EDFFDD118F5E6221D60EFF
USDC_ISSUER=GBBD47AB2EB00E041B61C1B7AD184E687E24658D52EDFFDD118F5E6221D60EFF
WALLET_NONCE_EXPIRY=600

# Email notifications (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=notifications@example.com

# Reverse proxy: how request.ip is derived from X-Forwarded-For.
# false = direct connections; 1 = one trusted proxy hop; or a comma separated
# list of trusted proxy IPs/CIDRs. Avoid `true` (clients can forge the header).
TRUST_PROXY=false

# Rate limiting (see docs/RATE_LIMITING.md; classes are defined in src/config/rate-limit.ts)
RATE_LIMIT_ENABLED=true
# memory = per instance; redis = shared across instances via REDIS_URL
RATE_LIMIT_STORE=memory
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=60000
RATE_LIMIT_SENSITIVE_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=60000

# Tip media uploads (see docs/MEDIA.md)
# local = files on disk under MEDIA_LOCAL_ROOT; s3 = presigned uploads to a bucket
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=var/media
MEDIA_STORAGE_TIMEOUT_MS=15000
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
# Optional CDN in front of storage; when set, responses use CDN URLs.
MEDIA_CDN_BASE_URL=
# direct = browser PUTs to storage; proxy = bytes through the API
MEDIA_UPLOAD_MODE=direct
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=67108864
MEDIA_DEFAULT_QUOTA_BYTES=268435456
# clamav (production) | eicar (development) | none (refuses every upload)
MEDIA_SCANNER=eicar
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# auto = route by media kind | sharp | ffmpeg | none
MEDIA_PROCESSOR=auto
MEDIA_TRANSCODE_VIDEO=false
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
